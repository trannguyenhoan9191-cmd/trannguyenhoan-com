---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import SocialChannels from '../components/SocialChannels.astro';
import GtmBody from '../components/GtmBody.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latestPosts = posts.slice(0, 6);
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<GtmBody />
		<Header />
		<main class="hero-main">
			<section class="hero">
				<div class="hero-badge">
					<span class="dot-live"></span>
					<span>AI Operating Brain — Đang vận hành</span>
				</div>
				<h1 class="hero-title">
					Người Việt kinh doanh<br/>
					<span class="gradient-text">không bị bỏ lại</span><br/>
					phía sau bởi <span class="ai-text">AI</span>.
				</h1>
				<p class="hero-sub">
					Tôi là <strong>Trần Nguyên Hoàn</strong>. Tôi xây bộ não AI vận hành bằng dữ liệu thật cho chính mình — và viết lại hành trình đó để chủ shop, freelancer, SME Việt Nam có thể làm cùng.
				</p>
				<div class="hero-cta">
					<a href="/blog" class="btn-primary">Đọc blog →</a>
					<a href="/about" class="btn-secondary">Về tôi</a>
				</div>

				<div class="hero-stats">
					<div class="stat-card">
						<div class="stat-value">4 Lớp</div>
						<div class="stat-label">Kiến trúc bộ não AI</div>
					</div>
					<div class="stat-card">
						<div class="stat-value">100%</div>
						<div class="stat-label">Data thật của bạn</div>
					</div>
					<div class="stat-card">
						<div class="stat-value">0đ</div>
						<div class="stat-label">Đội kỹ thuật</div>
					</div>
				</div>

				<NewsletterForm variant="hero" />
			</section>

			<SocialChannels heading="Theo dõi Hoàn ở các kênh" />

			<section class="latest">
				<div class="section-header">
					<h2 class="section-title">Bài viết gần đây</h2>
					<a href="/blog" class="section-link">Xem tất cả →</a>
				</div>
				<ul class="post-list">
					{latestPosts.map((post) => (
						<li class="post-item">
							<a href={`/blog/${post.id}/`}>
								<div class="post-meta">
									<FormattedDate date={post.data.pubDate} />
								</div>
								<h3 class="post-title">{post.data.title}</h3>
								<p class="post-desc">{post.data.description}</p>
								<span class="post-arrow">→</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero-main {
		max-width: var(--max-width-wide);
	}

	.hero {
		padding: 4rem 0 5rem;
		text-align: center;
	}

	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: var(--glass-bg);
		border: 1px solid var(--glass-border);
		padding: 0.5rem 1rem;
		border-radius: 100px;
		font-size: 0.825rem;
		color: var(--text-muted);
		font-family: var(--font-mono);
		margin-bottom: 2rem;
		backdrop-filter: blur(10px);
	}

	.dot-live {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--success);
		box-shadow: 0 0 12px var(--success);
		animation: blink 2s ease-in-out infinite;
	}

	@keyframes blink {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.4; }
	}

	.hero-title {
		font-size: clamp(2.25rem, 5.5vw, 4rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.05;
		margin: 0 0 1.5rem;
		color: var(--text);
	}

	.gradient-text {
		background: linear-gradient(120deg, var(--accent), #fde68a, var(--accent));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		background-size: 200% auto;
		animation: shine 4s linear infinite;
	}

	@keyframes shine {
		to { background-position: 200% center; }
	}

	.ai-text {
		background: linear-gradient(135deg, var(--accent) 0%, var(--accent-dark) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		filter: drop-shadow(0 0 24px var(--accent-glow));
	}

	.hero-sub {
		font-size: 1.125rem;
		color: var(--text-muted);
		max-width: 620px;
		margin: 0 auto 2.5rem;
		line-height: 1.7;
	}

	.hero-cta {
		display: flex;
		gap: 0.75rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-bottom: 4rem;
	}

	.btn-primary, .btn-secondary {
		display: inline-flex;
		align-items: center;
		padding: 0.875rem 1.75rem;
		border-radius: 12px;
		font-weight: 600;
		font-size: 0.95rem;
		transition: all 0.2s ease;
		border: 1px solid transparent;
	}

	.btn-primary {
		background: linear-gradient(135deg, var(--accent) 0%, var(--accent-dark) 100%);
		color: var(--bg-from);
		box-shadow: 0 10px 30px var(--accent-shadow);
	}

	.btn-primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 15px 40px var(--accent-shadow);
		color: var(--bg-from);
	}

	.btn-secondary {
		background: var(--glass-bg);
		color: var(--text);
		border-color: var(--glass-border);
		backdrop-filter: blur(10px);
	}

	.btn-secondary:hover {
		background: var(--glass-bg-hover);
		border-color: var(--glass-border-hover);
		color: var(--text);
		transform: translateY(-2px);
	}

	.hero-stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		max-width: 640px;
		margin: 0 auto;
	}

	.stat-card {
		background: var(--glass-bg);
		border: 1px solid var(--glass-border);
		border-radius: 16px;
		padding: 1.5rem 1rem;
		backdrop-filter: blur(10px);
		transition: all 0.2s ease;
	}

	.stat-card:hover {
		border-color: var(--glass-border-hover);
		transform: translateY(-2px);
	}

	.stat-value {
		font-size: 1.75rem;
		font-weight: 800;
		color: var(--accent);
		letter-spacing: -0.02em;
		font-family: var(--font-mono);
	}

	.stat-label {
		font-size: 0.825rem;
		color: var(--text-muted);
		margin-top: 0.25rem;
	}

	.latest {
		padding: 3rem 0;
	}

	.section-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.5rem;
	}

	.section-title {
		font-size: 0.825rem;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--text-dim);
		font-weight: 600;
		margin: 0;
		font-family: var(--font-mono);
	}

	.section-link {
		font-size: 0.875rem;
		color: var(--text-muted);
		font-family: var(--font-mono);
	}

	.section-link:hover {
		color: var(--accent);
	}

	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 1rem;
	}

	.post-item {
		margin: 0;
	}

	.post-item a {
		display: block;
		padding: 1.5rem;
		background: var(--glass-bg);
		border: 1px solid var(--glass-border);
		border-radius: 16px;
		color: var(--text);
		transition: all 0.2s ease;
		backdrop-filter: blur(10px);
		height: 100%;
		position: relative;
	}

	.post-item a:hover {
		background: var(--glass-bg-hover);
		border-color: var(--glass-border-hover);
		transform: translateY(-2px);
		color: var(--text);
	}

	.post-item a:hover .post-arrow {
		transform: translateX(4px);
		color: var(--accent);
	}

	.post-meta {
		font-size: 0.75rem;
		color: var(--text-dim);
		font-family: var(--font-mono);
		margin-bottom: 0.75rem;
	}

	.post-title {
		font-size: 1.15rem;
		font-weight: 700;
		margin: 0 0 0.5rem;
		letter-spacing: -0.01em;
		color: var(--text);
		line-height: 1.4;
	}

	.post-desc {
		color: var(--text-muted);
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-arrow {
		position: absolute;
		top: 1.5rem;
		right: 1.5rem;
		color: var(--text-dim);
		font-size: 1.25rem;
		transition: all 0.2s ease;
	}

	@media (max-width: 720px) {
		.hero-stats {
			grid-template-columns: 1fr;
		}
		.post-list {
			grid-template-columns: 1fr;
		}
	}
</style>
