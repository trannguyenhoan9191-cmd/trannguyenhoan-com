---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import GtmBody from '../components/GtmBody.astro';
import hoanPortrait from '../assets/hoan-portrait.jpg';

// Trang chủ phiên bản landing page. Giá và nơi thanh toán cần được xác nhận trước khi xuất bản.
// Nút tư vấn trỏ đến trang kết nối đang tồn tại, KHÔNG giả lập checkout hay thu tiền.
const COURSE_PRICE = '1.999.000đ';
const CONSULTATION_URL = '/ket-noi';
const FREE_ZOOM_URL = 'https://zoom.trannguyenhoan.com/';

const problems = [
  { icon: '😣', text: 'Đăng bài mỗi ngày nhưng ít người quan tâm, ít khách hàng hỏi mua.' },
  { icon: '❓', text: 'Không biết khách hàng cần gì và nên viết nội dung bắt đầu từ đâu.' },
  { icon: '📷', text: 'Muốn có ảnh sản phẩm đẹp nhưng không biết thiết kế.' },
  { icon: '🎥', text: 'Muốn làm video bán hàng nhưng ngại quay, không biết dựng.' },
  { icon: '⏱️', text: 'Mất quá nhiều thời gian sáng tạo nội dung mà chưa mang lại kết quả.' },
  { icon: '👤', text: 'Muốn xây dựng thương hiệu cá nhân nhưng thiếu hình ảnh chuyên nghiệp.' },
];

const modules = [
  { no: '01', icon: '🎯', title: 'Xây dựng hồ sơ khách hàng tiềm năng bằng AI', text: 'Phân tích nhu cầu, nỗi đau, mong muốn và hành vi mua hàng để hiểu đúng người cần tiếp cận.', visual: 'customer' },
  { no: '02', icon: '🔎', title: 'Nghiên cứu chủ đề thu hút khách hàng', text: 'Tìm chủ đề, góc nhìn và câu hỏi khách hàng quan tâm để không bí ý tưởng mỗi ngày.', visual: 'research' },
  { no: '03', icon: '✍️', title: 'Viết content thu hút bằng AI', text: 'Tạo tiêu đề, câu mở đầu và bài viết thực chiến với AIDA, PAS, Storytelling.', visual: 'content' },
  { no: '04', icon: '🖼️', title: 'Tạo ảnh sản phẩm và thương hiệu cá nhân', text: 'Làm ảnh sản phẩm, poster, banner và ảnh cá nhân rõ thông điệp, đồng bộ thương hiệu.', visual: 'image' },
  { no: '05', icon: '🎬', title: 'Edit video tự động bằng AI', text: 'Biến nội dung thô thành video có nhịp độ, phụ đề, hình ảnh minh họa và định dạng phù hợp.', visual: 'edit' },
  { no: '06', icon: '🤖', title: 'Tự động tạo video AI', text: 'Lên kịch bản, chia cảnh, tạo hình và dựng video marketing bằng những công cụ AI phù hợp.', visual: 'video' },
];

const outcomes = [
  { icon: '🎯', title: 'Chân dung khách hàng', text: 'Biết rõ mình đang nói với ai' },
  { icon: '🗂️', title: 'Ngân hàng chủ đề', text: 'Có ý tưởng phù hợp mỗi ngày' },
  { icon: '✍️', title: 'Quy trình viết bài', text: 'Tạo content theo mục tiêu' },
  { icon: '🖼️', title: 'Bộ hình ảnh', text: 'Ảnh sản phẩm và cá nhân' },
  { icon: '▶️', title: 'Quy trình edit video', text: 'Dựng video gọn hơn' },
  { icon: '⚙️', title: 'Kỹ năng làm video AI', text: 'Ứng dụng vào nội dung thực tế' },
];

const audiences = [
  { icon: '🛍️', name: 'Chủ shop, kinh doanh online', desc: 'Muốn chủ động thu hút khách hàng và trình bày sản phẩm chuyên nghiệp.' },
  { icon: '🏢', name: 'Chủ doanh nghiệp nhỏ', desc: 'Muốn tối ưu thời gian và nguồn lực làm marketing.' },
  { icon: '💻', name: 'Người làm marketing, bán hàng', desc: 'Muốn nâng cao tốc độ tạo nội dung và hiệu quả công việc.' },
  { icon: '📹', name: 'Người xây dựng thương hiệu cá nhân', desc: 'Muốn có bài viết, hình ảnh và video nhất quán.' },
];

const questions = [
  { q: 'Tôi không giỏi công nghệ có học được không?', a: 'Có. Chương trình hướng dẫn từ những bước cơ bản, thực hành trên các tình huống marketing và bán hàng. Bạn nên có máy tính để làm theo thuận tiện hơn.' },
  { q: 'Tôi chưa biết viết content, thiết kế ảnh, dựng video thì sao?', a: 'Bạn có thể bắt đầu từ số 0. Nội dung được sắp xếp theo trình tự: hiểu khách hàng, nghiên cứu chủ đề, viết bài, tạo ảnh rồi làm video.' },
  { q: 'Tôi chưa có kinh nghiệm marketing có học được không?', a: 'Có. Bạn sẽ học cách xác định khách hàng mục tiêu và triển khai một quy trình nội dung đơn giản trước khi mở rộng.' },
  { q: 'Học xong có chắc chắn thu hút được khách hàng không?', a: 'Không có cam kết kết quả kinh doanh cố định. Kết quả phụ thuộc vào sản phẩm, thị trường, mức độ thực hành và cách bạn kiểm tra, tối ưu nội dung.' },
  { q: 'Giá khóa học và cách đăng ký thế nào?', a: 'Mức giá đang trình bày trong bản thiết kế này là 1.999.000đ theo ảnh mẫu. Vui lòng liên hệ để xác nhận học phí, lịch khai giảng và phương thức thanh toán chính thức.' },
];
---

<!doctype html>
<html lang="vi">
  <head>
    <BaseHead
      title="AI Marketing & Bán hàng 24/7 | Trần Nguyên Hoàn"
      description="6 nội dung ứng dụng AI thực chiến: nghiên cứu khách hàng, viết content, thiết kế hình ảnh và làm video marketing. Hướng dẫn bởi Trần Nguyên Hoàn."
    />
  </head>
  <body>
    <GtmBody />

    <header class="site-top">
      <div class="nav-wrap">
        <a class="brand" href="/" aria-label="Trần Nguyên Hoàn - trang chủ">
          <span class="brand-icon">AI</span>
          <span class="brand-text"><strong>TRẦN NGUYÊN HOÀN</strong><small>AI MARKETING & BÁN HÀNG</small></span>
        </a>
        <nav aria-label="Điều hướng chính">
          <a href="#noi-dung">Nội dung</a>
          <a href="#nguoi-huong-dan">Người hướng dẫn</a>
          <a href="/blog">Blog</a>
          <a href="/about">Giới thiệu</a>
        </nav>
        <a class="nav-cta" href={FREE_ZOOM_URL} target="_blank" rel="noopener noreferrer" data-cta="free-zoom">Học Zoom miễn phí ↗</a>
      </div>
    </header>

    <main class="landing">
      <section class="hero-area">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <span class="eyebrow">ỨNG DỤNG AI THỰC CHIẾN • CHO NGƯỜI MỚI</span>
            <h1>CÁCH THU HÚT <span>KHÁCH HÀNG TIỀM NĂNG</span> <em>BẰNG AI 24/7</em></h1>
            <p class="hero-punch">NGAY CẢ KHI BẠN ĐANG NGỦ!</p>
            <p class="hero-desc">Biết cách dùng AI để hiểu khách hàng, tạo nội dung, hình ảnh và video marketing — từng bước, dễ áp dụng.</p>
            <ul class="hero-benefits">
              <li><span>✓</span> Hiểu khách hàng và tìm đúng chủ đề</li>
              <li><span>✓</span> Viết content thu hút, tạo ảnh sản phẩm</li>
              <li><span>✓</span> Edit video tự động, làm video AI</li>
              <li><span>✓</span> Từng bước xây quy trình nội dung hiệu quả</li>
            </ul>
            <div class="hero-price"><small>HỌC PHÍ THAM KHẢO</small><strong>{COURSE_PRICE}</strong></div>
            <a href={CONSULTATION_URL} class="action-primary" data-cta="hero-consult">TƯ VẤN & ĐĂNG KÝ KHÓA HỌC <span aria-hidden="true">→</span></a>
            <div class="hero-notes"><span>◉ Thực hành từng bước</span><span>◉ Dành cho người mới</span><span>◉ Học ứng dụng thực tế</span></div>
          </div>
          <div class="hero-art" aria-label="Hình ảnh người hướng dẫn Trần Nguyên Hoàn">
            <div class="orbit orbit-one" aria-hidden="true"></div>
            <div class="orbit orbit-two" aria-hidden="true"></div>
            <div class="ai-orb" aria-hidden="true"><span>AI</span><small>24/7</small></div>
            <div class="floating-card float-left" aria-hidden="true"><span>✦ AI CONTENT</span><div class="fake-line"></div><div class="fake-line short"></div><div class="fake-pills"><i></i><i></i><i></i></div></div>
            <div class="floating-card float-right" aria-hidden="true"><span>▣ VIDEO AI</span><div class="video-symbol">▶</div><small>Ý tưởng → video</small></div>
            <div class="portrait-ring">
              <Image src={hoanPortrait} alt="Trần Nguyên Hoàn, người hướng dẫn ứng dụng AI vào Marketing và bán hàng" loading="eager" widths={[320, 480, 700]} sizes="(max-width: 760px) 76vw, 440px" />
            </div>
            <div class="portrait-caption"><strong>TRẦN NGUYÊN HOÀN</strong><span>AI MARKETING & BÁN HÀNG</span></div>
          </div>
        </div>
      </section>

      <section class="light-section" id="van-de">
        <div class="wrap section-pad">
          <h2 class="section-heading">BẠN CÓ ĐANG GẶP <span>NHỮNG VẤN ĐỀ NÀY?</span></h2>
          <div class="problems-grid">
            {problems.map(item => (
              <div class="problem-card"><span class="problem-icon" aria-hidden="true">{item.icon}</span><p>{item.text}</p></div>
            ))}
          </div>
          <div class="insight"><span aria-hidden="true">💡</span><p><strong>Vấn đề không phải bạn thiếu chăm chỉ.</strong><br/>Có thể bạn đang thiếu một quy trình marketing rõ ràng và công cụ phù hợp.</p></div>
        </div>
      </section>

      <section class="modules-section" id="noi-dung">
        <div class="wrap section-pad">
          <span class="section-kicker">HỌC ĐẾN ĐÂU • THỰC HÀNH ĐẾN ĐÓ</span>
          <h2 class="section-heading on-dark"><em>6 NỘI DUNG</em> THỰC CHIẾN BẠN SẼ ĐƯỢC HỌC</h2>
          <div class="module-grid">
            {modules.map(item => (
              <article class="module-card">
                <div class="module-illustration">
                  <span class="module-number">{item.no}</span>
                  <div class="illustration-center"><span aria-hidden="true">{item.icon}</span><b>{item.visual === 'customer' ? 'KHÁCH HÀNG' : item.visual === 'research' ? 'INSIGHT' : item.visual === 'content' ? 'CONTENT AI' : item.visual === 'image' ? 'AI DESIGN' : item.visual === 'edit' ? 'AI EDITOR' : 'VIDEO AI'}</b></div>
                  <div class="illustration-line" aria-hidden="true"></div>
                </div>
                <div class="module-body"><h3>{item.title}</h3><p>{item.text}</p></div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="light-section outcomes-section">
        <div class="wrap section-pad">
          <h2 class="section-heading">SAU KHÓA HỌC, <span>BẠN SẼ CÓ GÌ?</span></h2>
          <p class="section-intro">Không chỉ nghe về AI, bạn có những công việc cụ thể để luyện tập và áp dụng vào hoạt động marketing của mình.</p>
          <div class="outcomes-grid">
            {outcomes.map(item => (
              <div class="outcome-card"><span aria-hidden="true">{item.icon}</span><h3>{item.title}</h3><p>{item.text}</p></div>
            ))}
          </div>
        </div>
      </section>

      <section class="audience-section">
        <div class="wrap audience-pad">
          <div class="audience-shell">
            <h2 class="section-heading on-dark">KHÓA HỌC NÀY DÀNH CHO AI?</h2>
            <div class="audience-grid">
              {audiences.map(item => (
                <article class="audience-card">
                  <div class="audience-visual" aria-hidden="true">{item.icon}</div>
                  <div class="audience-info"><h3>{item.name}</h3><p>{item.desc}</p></div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="mentor-section light-section" id="nguoi-huong-dan">
        <div class="wrap mentor-grid">
          <div class="mentor-photo"><Image src={hoanPortrait} alt="Ảnh chân dung người hướng dẫn Trần Nguyên Hoàn" loading="lazy" widths={[320, 520, 760]} sizes="(max-width: 760px) 100vw, 460px" /></div>
          <div class="mentor-copy">
            <span class="section-kicker dark-kicker">NGƯỜI HƯỚNG DẪN</span>
            <h2>TRẦN NGUYÊN HOÀN</h2>
            <ul>
              <li><span>✓</span> Hướng dẫn ứng dụng AI thực chiến trong Marketing và Bán hàng.</li>
              <li><span>✓</span> Đưa công cụ AI vào những công việc thực tế của người kinh doanh.</li>
              <li><span>✓</span> Tập trung vào cách làm đơn giản, dễ hiểu và có thể thực hành.</li>
            </ul>
            <blockquote>“CON NGƯỜI TẠO GIÁ TRỊ – AI NHÂN LÊN”</blockquote>
          </div>
        </div>
      </section>

      <section class="price-section" id="dang-ky">
        <div class="wrap price-inner">
          <p>ĐẦU TƯ VÀO KỸ NĂNG MARKETING BẰNG AI CỦA BẠN</p>
          <h2>CHỈ <span>{COURSE_PRICE}</span></h2>
          <a href={CONSULTATION_URL} class="action-primary" data-cta="pricing-consult">NHẬN TƯ VẤN & ĐĂNG KÝ <span aria-hidden="true">→</span></a>
          <small>Giá theo bản thiết kế tham khảo. Học phí và thông tin thanh toán được xác nhận khi tư vấn; website chưa thu tiền trực tiếp.</small>
        </div>
      </section>

      <section class="light-section faq-section" id="cau-hoi">
        <div class="wrap section-pad">
          <h2 class="section-heading">CÂU HỎI THƯỜNG GẶP</h2>
          <div class="faq-list">
            {questions.map((item, i) => (
              <details>
                <summary><span class="faq-index">{i+1}</span><span>{item.q}</span><span class="faq-chevron" aria-hidden="true">⌄</span></summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
          <div class="faq-bottom">Bạn muốn xem nội dung miễn phí trước? <a href={FREE_ZOOM_URL} target="_blank" rel="noopener noreferrer" data-cta="faq-free-zoom">Tham gia Zoom cùng Hoàn ↗</a></div>
        </div>
      </section>
    </main>

    <footer class="custom-footer">
      <div class="wrap footer-inside"><div><strong>TRẦN NGUYÊN HOÀN</strong><span>Con người tạo giá trị – AI nhân lên</span></div><nav aria-label="Liên kết chân trang"><a href="/blog">Blog</a><a href="/about">Về Hoàn</a><a href="/ket-noi">Kết nối</a><a href="https://www.youtube.com/@hoanaimkt" target="_blank" rel="noopener noreferrer">YouTube</a></nav></div>
    </footer>

    <div class="mobile-bar"><span><small>HỌC PHÍ THAM KHẢO</small><strong>{COURSE_PRICE}</strong></span><a href={CONSULTATION_URL} data-cta="mobile-consult">ĐĂNG KÝ →</a></div>

    <script>
      document.querySelectorAll<HTMLAnchorElement>('a[data-cta]').forEach((link) => {
        link.addEventListener('click', () => {
          if (Array.isArray((window as any).dataLayer)) {
            (window as any).dataLayer.push({ event: 'landing_cta_click', cta_name: link.dataset.cta, page_name: 'ai-marketing-247' });
          }
        });
      });
    </script>
  </body>
</html>

<style>
  :global(html) { scroll-padding-top: 86px; }
  :global(body) { background: #061b3a; overflow-x: hidden; }
  :global(body) .landing { padding: 0; margin: 0; max-width: none; width: 100%; }
  :global(body) .landing :is(h1,h2,h3,p,ul) { margin-top: 0; }
  .wrap { width: min(1180px, calc(100% - 40px)); margin-inline: auto; }
  .site-top { position: relative; z-index: 25; background: #031632; border-bottom: 1px solid #173968; }
  .nav-wrap { max-width: 1180px; min-height: 74px; margin: auto; padding: 10px 20px; display: flex; align-items: center; gap: 24px; justify-content: space-between; }
  .brand { display: flex; align-items: center; gap: 10px; color: #fff; flex-shrink: 0; }
  .brand-icon { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 13px; border: 1px solid #20bbec; color: #77edff; font-weight: 900; background: linear-gradient(145deg,#113a79,#05284b); box-shadow: 0 0 16px #04ccff22; }
  .brand-text { display:flex; flex-direction:column; line-height: 1.25; }
  .brand-text strong { color: #fff; font-size: 14px; letter-spacing: .045em; }
  .brand-text small { color: #90cfff; font-size: 9px; letter-spacing: .09em; }
  .site-top nav { display:flex; align-items:center; gap: 21px; }
  .site-top nav a { color:#dbecff; font-size: 13px; font-weight: 700; }
  .site-top nav a:hover { color:#ffe238; }
  .nav-cta { background: #ed152e; color:#fff; font-weight: 800; font-size: 13px; padding: 12px 15px; border-radius: 9px; white-space: nowrap; }
  .nav-cta:hover { color:#fff; background:#ca0924; }
  .hero-area { background: radial-gradient(circle at 70% 48%,#0b4a8f 0%,transparent 41%),linear-gradient(115deg,#03142e 10%,#052b61 72%,#031a3a); position:relative; overflow:hidden; }
  .hero-area:before { content:""; position:absolute; inset:0; opacity:.26; background-image:linear-gradient(#1471a922 1px,transparent 1px),linear-gradient(90deg,#1471a922 1px,transparent 1px); background-size:46px 46px; }
  .hero-glow {position:absolute; width:560px; height:560px; background:radial-gradient(circle,#00c4ff48,transparent 65%); filter:blur(20px); right:-80px; top:0; pointer-events:none;}
  .hero-grid { display:grid; grid-template-columns: 55% 45%; align-items:center; min-height: 620px; position:relative; padding-top: 52px; padding-bottom: 42px; }
  .hero-copy { z-index:3; padding-bottom: 12px; }
  .eyebrow,.section-kicker { display:inline-block; color:#75d4ff; font-size:12px; letter-spacing:.15em; font-weight:800; margin-bottom: 19px; }
  .hero-copy h1 { color:#fff; font-weight:900; font-size:clamp(36px,4.2vw,61px); letter-spacing:-.045em; line-height:1.04; margin:0 0 7px; text-transform:uppercase; }
  .hero-copy h1 span {display:block;}
  .hero-copy h1 em { display:block; font-size:1.14em; font-style:normal; color:#ffe12e; margin-top:8px; text-shadow:0 7px 23px #d7a90033; }
  .hero-punch { font-size:clamp(17px,2vw,23px); color:#fff; font-weight:900; margin-bottom:18px!important; letter-spacing:.02em; }
  .hero-desc {color:#cbdff3; max-width:570px; font-size:15px; line-height:1.55; margin-bottom:18px!important;}
  .hero-benefits {list-style:none; padding:0; margin:0 0 23px!important; display:grid; gap:7px;}
  .hero-benefits li {color:#edf7ff; display:flex; align-items:center; gap:10px; margin:0; font-size:14px; line-height:1.4;}
  .hero-benefits li span {background:#14c975; color:#003a30; height:19px; width:19px; border-radius:50%; display:inline-grid; place-items:center; font-size:13px; font-weight:900; flex-shrink:0;}
  .hero-price { display:inline-flex; align-items:center; gap:10px; background:#fff; border-radius:10px; padding:10px 16px; margin-bottom:12px; box-shadow:0 13px 30px #010f2266;}
  .hero-price small {font-size:11px; color:#0b2546; font-weight:850; max-width:85px; line-height:1.2;}
  .hero-price strong {color:#ed1739; font-size:29px; letter-spacing:-.04em; white-space:nowrap; line-height:1;}
  .action-primary { display:flex; align-items:center; justify-content:center; gap:12px; width:max-content; max-width:100%; text-align:center; color:#fff; background:linear-gradient(180deg,#ff2339,#d8082a); border: 1px solid #ff4557; box-shadow:0 10px 24px #e0003155; border-radius:10px; padding:15px 25px; font-size:15px; font-weight:900; transition:transform .18s,filter .18s; }
  .action-primary:hover { transform:translateY(-2px); color:#fff; filter:brightness(1.12); }
  .action-primary span {font-size:23px; line-height:0;}
  .hero-notes {display:flex; flex-wrap:wrap; gap:9px 18px; margin-top:23px; font-size:11px; color:#c8dff6; font-weight:650;}
