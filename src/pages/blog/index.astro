---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import GtmBody from '../../components/GtmBody.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead title="Blog" description="Hành trình xây bộ não AI vận hành — chia sẻ thật từ Trần Nguyên Hoàn." />
	</head>
	<body>
		<GtmBody />
		<Header />
		<main>
			<section class="page-header">
				<div class="badge">
					<span>◆ Blog</span>
				</div>
				<h1>Hành trình AI</h1>
				<p class="lead">
					Cách tôi build, sai lầm tôi mắc, và những gì tôi học được khi xây bộ não AI vận hành bằng dữ liệu thật.
				</p>
			</section>

			<section class="post-list">
				{posts.map((post) => (
					<article class="post-card">
						<a href={`/blog/${post.id}/`}>
							<div class="post-meta">
								<FormattedDate date={post.data.pubDate} />
							</div>
							<h2 class="post-title">{post.data.title}</h2>
							<p class="post-desc">{post.data.description}</p>
							<span class="post-arrow">Đọc tiếp →</span>
						</a>
					</article>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-header {
		text-align: center;
		padding: 4rem 0 3rem;
	}

	.badge {
		display: inline-flex;
		background: var(--glass-bg);
		border: 1px solid var(--glass-border);
		padding: 0.4rem 0.875rem;
		border-radius: 100px;
		font-size: 0.8rem;
		color: var(--accent);
		font-family: var(--font-mono);
		margin-bottom: 1.5rem;
		backdrop-filter: blur(10px);
	}

	.page-header h1 {
		font-size: clamp(2.5rem, 5vw, 3.5rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		margin: 0 0 1rem;
		line-height: 1.1;
	}

	.lead {
		font-size: 1.125rem;
		color: var(--text-muted);
		max-width: 560px;
		margin: 0 auto;
		line-height: 1.7;
	}

	.post-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 2rem 0 4rem;
	}

	.post-card {
		background: var(--glass-bg);
		border: 1px solid var(--glass-border);
		border-radius: 20px;
		transition: all 0.2s ease;
		backdrop-filter: blur(10px);
	}

	.post-card:hover {
		background: var(--glass-bg-hover);
		border-color: var(--glass-border-hover);
		transform: translateY(-3px);
	}

	.post-card a {
		display: block;
		padding: 2rem 1.75rem;
		color: var(--text);
	}

	.post-card a:hover {
		color: var(--text);
	}

	.post-meta {
		font-size: 0.8rem;
		color: var(--text-dim);
		font-family: var(--font-mono);
		margin-bottom: 0.75rem;
	}

	.post-title {
		font-size: 1.5rem;
		font-weight: 700;
		margin: 0 0 0.75rem;
		letter-spacing: -0.02em;
		line-height: 1.3;
		color: var(--text);
		transition: color 0.2s ease;
	}

	.post-card:hover .post-title {
		color: var(--accent);
	}

	.post-desc {
		color: var(--text-muted);
		margin: 0 0 1rem;
		font-size: 1rem;
		line-height: 1.6;
	}

	.post-arrow {
		font-size: 0.875rem;
		color: var(--accent);
		font-weight: 500;
		font-family: var(--font-mono);
	}

	@media (max-width: 720px) {
		.post-card a {
			padding: 1.5rem 1.25rem;
		}
		.post-title {
			font-size: 1.25rem;
		}
	}
</style>
