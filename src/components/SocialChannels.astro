---
interface Props {
	heading?: string;
	subheading?: string;
	compact?: boolean;
}

const {
	heading = 'Theo dõi Hoàn',
	subheading = 'Tôi đăng nội dung khác nhau trên mỗi kênh — chọn kênh phù hợp với bạn',
	compact = false,
} = Astro.props;

const channels = [
	{
		key: 'youtube',
		url: 'https://www.youtube.com/@hoanclaude',
		name: 'YouTube',
		handle: '@hoanclaude',
		desc: 'Video dài, demo bộ não AI',
		svg: '<svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>',
	},
	{
		key: 'tiktok',
		url: 'https://www.tiktok.com/@hoanclaude',
		name: 'TikTok',
		handle: '@hoanclaude',
		desc: 'Insight ngắn, hook mạnh',
		svg: '<svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.84-.1z"/></svg>',
	},
	{
		key: 'facebook',
		url: 'https://www.facebook.com/hoanclaude/',
		name: 'Fanpage',
		handle: '/hoanclaude',
		desc: 'Cập nhật chính thức',
		svg: '<svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>',
	},
	{
		key: 'facebook-personal',
		url: 'https://www.facebook.com/hoanclaudeprofile/',
		name: 'FB cá nhân',
		handle: '/hoanclaudeprofile',
		desc: 'Đời sống + behind-the-scene',
		svg: '<svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm3 8h-1.35c-.538 0-.65.221-.65.778V10h2l-.209 2H13v7h-3v-7H8v-2h2V7.692C10 5.923 10.931 5 13.029 5H15v3z"/></svg>',
	},
];
---

<section class={`channels-block ${compact ? 'compact' : ''}`}>
	<div class="channels-header">
		<div class="section-label">KẾT NỐI</div>
		<h2>{heading}</h2>
		{subheading && <p class="channels-sub">{subheading}</p>}
	</div>

	<div class="channels-grid">
		{channels.map((c) => (
			<a
				href={c.url}
				target="_blank"
				rel="noopener"
				class={`channel channel-${c.key}`}
				aria-label={`${c.name} ${c.handle}`}
				data-social-channel={c.key}
			>
				<Fragment set:html={c.svg} />
				<div class="channel-name">{c.name}</div>
				<div class="channel-handle">{c.handle}</div>
				{!compact && <div class="channel-desc">{c.desc}</div>}
			</a>
		))}
	</div>
</section>

<style>
	.channels-block {
		margin: 3rem 0;
	}

	.channels-block.compact {
		margin: 2rem 0;
	}

	.channels-header {
		text-align: center;
		margin-bottom: 1.75rem;
	}

	.section-label {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: var(--accent);
		font-weight: 700;
		font-family: var(--font-mono);
		margin-bottom: 0.75rem;
	}

	.channels-block h2 {
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		margin: 0 0 0.75rem;
		color: var(--text);
	}

	.channels-sub {
		color: var(--text-muted);
		max-width: 520px;
		margin: 0 auto;
		font-size: 0.95rem;
	}

	.channels-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1rem;
	}

	.compact .channels-grid {
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
	}

	.channel {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		padding: 1.5rem 1.25rem;
		background: var(--glass-bg);
		border: 1px solid var(--glass-border);
		border-radius: 16px;
		color: var(--text);
		transition: all 0.2s ease;
		backdrop-filter: blur(10px);
		text-decoration: none;
	}

	.compact .channel {
		padding: 1.125rem 1rem;
	}

	.channel:hover {
		transform: translateY(-3px);
		color: var(--text);
	}

	.channel-youtube:hover {
		border-color: #ff0000;
		background: linear-gradient(135deg, rgba(255, 0, 0, 0.18), rgba(255, 0, 0, 0.05));
		box-shadow: 0 12px 32px rgba(255, 0, 0, 0.2);
	}
	.channel-youtube svg { color: #ff0000; }

	.channel-tiktok:hover {
		border-color: #ee1d52;
		background: linear-gradient(135deg, rgba(238, 29, 82, 0.18), rgba(37, 244, 238, 0.08));
		box-shadow: 0 12px 32px rgba(238, 29, 82, 0.2);
	}
	.channel-tiktok svg { color: #ffffff; }

	.channel-facebook:hover,
	.channel-facebook-personal:hover {
		border-color: #1877f2;
		background: linear-gradient(135deg, rgba(24, 119, 242, 0.18), rgba(24, 119, 242, 0.05));
		box-shadow: 0 12px 32px rgba(24, 119, 242, 0.2);
	}
	.channel-facebook svg,
	.channel-facebook-personal svg { color: #1877f2; }

	.channel-name {
		font-weight: 700;
		font-size: 1rem;
		color: var(--text);
	}

	.channel-handle {
		font-size: 0.85rem;
		color: var(--accent);
		font-family: var(--font-mono);
	}

	.channel-desc {
		font-size: 0.8rem;
		color: var(--text-muted);
		margin-top: 0.25rem;
		text-align: center;
	}

	@media (min-width: 720px) {
		.channels-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>

<script>
	// GTM event when user clicks social channel
	document.querySelectorAll<HTMLAnchorElement>('[data-social-channel]').forEach((el) => {
		el.addEventListener('click', () => {
			const channel = el.dataset.socialChannel;
			if (typeof (window as any).dataLayer !== 'undefined') {
				(window as any).dataLayer.push({
					event: 'social_channel_click',
					channel,
				});
			}
			if (typeof (window as any).fbq === 'function') {
				(window as any).fbq('trackCustom', 'SocialChannelClick', { channel });
			}
		});
	});
</script>
