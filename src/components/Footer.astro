---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<span class="footer-mark">◆</span>
			<span>Trần Nguyên Hoàn</span>
		</div>
		<p class="footer-tagline">
			Người Việt kinh doanh không bị bỏ lại phía sau bởi công nghệ AI.
		</p>

		<div class="footer-links">
			{socials.map((s) => (
				<a
					href={s.url}
					target={s.url.startsWith('http') ? '_blank' : undefined}
					rel={s.url.startsWith('http') ? 'noopener' : undefined}
					aria-label={s.label}
					title={s.label}
				>
					<Fragment set:html={s.svg} />
				</a>
			))}
		</div>

		<div class="footer-meta">
			<span>© {today.getFullYear()} Trần Nguyên Hoàn</span>
			<span class="dot">·</span>
			<span>Built with Claude</span>
		</div>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--glass-border);
		margin-top: 6rem;
		padding: 3rem 1.5rem 2rem;
	}

	.footer-inner {
		max-width: var(--max-width-wide);
		margin: 0 auto;
		text-align: center;
	}

	.footer-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 600;
		color: var(--text);
		font-size: 1rem;
	}

	.footer-mark {
		color: var(--accent);
		filter: drop-shadow(0 0 8px var(--accent-glow));
	}

	.footer-tagline {
		color: var(--text-muted);
		font-size: 0.9rem;
		max-width: 520px;
		margin: 0.75rem auto 1.5rem;
		line-height: 1.6;
	}

	.footer-links {
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		margin: 1.5rem 0;
		flex-wrap: wrap;
	}

	.footer-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		background: var(--glass-bg);
		border: 1px solid var(--glass-border);
		border-radius: 10px;
		color: var(--text-muted);
		transition: all 0.2s ease;
	}

	.footer-links a:hover {
		color: var(--accent);
		border-color: var(--accent);
		background: var(--accent-glow);
		transform: translateY(-2px);
	}

	.footer-meta {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		font-size: 0.8rem;
		color: var(--text-dim);
		font-family: var(--font-mono);
		margin-top: 1.5rem;
	}

	.dot { opacity: 0.5; }
</style>
